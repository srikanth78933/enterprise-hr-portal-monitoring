# Non-secret settings for the ELK EC2 instance (passwords come from AWS Secrets Manager).
ELASTIC_VERSION=9.5.5
ENVIRONMENT=prod

# Where Elasticsearch stores its data (the separate EBS data volume)
DATA_DIR=/data

# JVM heap sizes (m7i-flex.large has 8 GiB: 3g Elasticsearch, 1g Logstash, the rest for Kibana and the OS cache)
ES_HEAP=3g
LS_HEAP=1g

# Days to keep data before Elasticsearch deletes it
LOGS_RETENTION_DAYS=14
METRICS_RETENTION_DAYS=7
